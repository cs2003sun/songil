# cp .env.example .env 후 값을 채우세요. run.sh 와 pregen_tts.py 가 이 파일을 읽습니다.
# .env 에는 API 키가 들어가므로 git 에 올리지 마세요 (.gitignore 에 포함됨).

# ---- 필수 ----
API_KEY=

# ---- 모델 ----
MODEL_NAME=yoloe-26l-seg.pt
DEFAULT_IMGSZ=640
HALF=1

# ---- 동시 접속 ----
BATCH_WAIT_MS=20
MAX_BATCH=16
MAX_QUEUE=48
REQUEST_TIMEOUT=1.5
DETECT_RATE_PER_SEC=5
DESCRIBE_RATE_PER_MIN=10
# /parse: 기기(X-Client-Id)별, 헤더가 없으면 IP별
PARSE_RATE_PER_MIN=20
PARSE_CACHE_SIZE=2000
# ip: IP 기준만 / ip+client: X-Client-Id 헤더가 있으면 IP+기기 기준 (같은 와이파이 관객 대비)
RATE_LIMIT_BY=ip+client
MAX_EXTRA_VOCAB=100

# ---- Gemini (/describe, /parse) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
PROMPT_FILE=prompt.txt
# 요청에 prompt 를 직접 넣어 보낼 때 최대 글자 수
MAX_PROMPT_CHARS=4000
# GET /describe-test 프롬프트 시험 페이지 (발표 때 끄려면 0)
TEST_PAGE=1
TIMEZONE=Asia/Seoul

# ---- ElevenLabs 음성 (/tts, pregen_tts.py) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 미리 생성용 (품질 우선) / 실시간 생성용 (속도 우선)
ELEVENLABS_PREGEN_MODEL=eleven_v3
ELEVENLABS_LIVE_MODEL=eleven_flash_v2_5
# 음성 설정: 비우면 그 목소리에 저장된 ElevenLabs 기본값 사용
#   STABILITY 0~1 (eleven_v3 는 0.0/0.5/1.0 중 가까운 값으로 맞춤), SIMILARITY 0~1, STYLE 0~1, SPEED 1.0 기준
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=
# 실시간 생성 하루 글자 수 상한 (캐시된 문장은 상한과 무관하게 계속 제공)
TTS_DAILY_CHAR_LIMIT=5000
TTS_RATE_PER_MIN=30
TTS_MAX_CHARS=200
TTS_TIMEOUT=8

# ---- 기타 ----
ALLOWED_ORIGINS=*
PORT=8000
LOG_DIR=logs
LOG_LEVEL=INFO
# /app 으로 제공할 폴더 (기본: server.py 옆의 static)
# STATIC_DIR=/home/사용자/yoloe-api/static

# ---- 고정 주소 터널 (비워두면 임시 trycloudflare 주소) ----
TUNNEL_TOKEN=
